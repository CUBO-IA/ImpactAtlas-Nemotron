# Connection string for the local Postgres started with docker compose.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nemotron"

# Audited catalog for this local dataset. Set explicitly; no catalog is inferred from DATABASE_URL.
DATA_CATALOG_PATH="./src/data/audited-catalog.json"

# HF model id, or absolute path to a local copy (q4 ONNX files required).
EMBEDDING_MODEL="onnx-community/embeddinggemma-2-ONNX"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nemotron
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nemotron
LFM3_MODEL_DIR=./models
DATA_CATALOG_PATH=./src/data/audited-catalog.json
