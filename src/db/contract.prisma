// use prisma-8

model User {
  id        Int                @id @default(autoincrement())
  email     String             @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Post {
  id        Int                @id @default(autoincrement())
  title     String
  content   String?
  author    User               @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model NemotronSvMuestra {
  id                    Int     @id @default(autoincrement())
  edad                  Int
  sexo                  String
  departamento          String
  nivel_educativo       String
  ocupacion             String
  ingreso_estimado_usd  Float
  sin_acceso_financiero Boolean
  meta_principal        String
  embedding             Raw(sql`vector(768)`)
}
